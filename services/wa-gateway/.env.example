# Wajib: isi token sendiri dan samakan dengan konfigurasi gateway pada aplikasi.
WA_GATEWAY_TOKEN=
WA_GATEWAY_PORT=3471
APP_INBOUND_URL=http://127.0.0.1:3000/api/wa/inbound

# Listener utama selalu 127.0.0.1. Kosongkan listener tambahan untuk development.
WA_GATEWAY_EXTRA_HOSTS=
WA_LOG_LEVEL=warn
WA_MIN_GAP_MS=1500
WA_MAX_GAP_MS=3500

# Opsional: default sesi disimpan di services/wa-gateway/.session (gitignored).
# WA_SESSION_DIR=/absolute/path/to/whatsapp-session
# WA_DEBUG_UPSERT=1
