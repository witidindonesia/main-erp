{
  "name": "mizu-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Template ERP monorepo: frontend Next.js, backend Go, mobile Expo, dan layanan opsional.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@mizu/frontend --filter=@mizu/backend",
    "dev:frontend": "pnpm --filter @mizu/frontend dev",
    "dev:backend": "pnpm --filter @mizu/backend dev",
    "dev:mobile": "pnpm --filter @mizu/mobile dev",
    "dev:legacy-services": "pnpm --filter @mizu/frontend dev:legacy",
    "build": "turbo run build --filter=@mizu/frontend --filter=@mizu/backend",
    "start": "pnpm --filter @mizu/frontend start",
    "test": "pnpm test:tooling && turbo run test",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "lint": "turbo run lint --filter=@mizu/frontend --filter=@mizu/backend",
    "check-types": "turbo run check-types",
    "typecheck": "pnpm check-types",
    "backend:dev": "pnpm dev:backend",
    "backend:test": "pnpm --filter @mizu/backend test",
    "db:migrate": "go -C apps/backend run ./cmd/migrate",
    "db:migrate:apply": "go -C apps/backend run ./cmd/migrate -apply",
    "db:seed": "pnpm --filter @mizu/database run",
    "db:seed:paddy-demo": "pnpm --filter @mizu/database run db:seed:paddy-demo",
    "db:seed:paddy-full": "pnpm --filter @mizu/database run db:seed:paddy-full",
    "pos:nfc-bridge": "pnpm --filter @mizu/pos-nfc-bridge start",
    "pos:nfc-bridge:install": "pnpm --filter @mizu/pos-nfc-bridge exec npm rebuild @pokusew/pcsclite --foreground-scripts",
    "pos:print-worker": "pnpm --filter @mizu/pos-print-worker start",
    "wa-gateway": "pnpm --filter @mizu/wa-gateway start",
    "wa-gateway:pair": "pnpm --filter @mizu/wa-gateway pair",
    "backend:audit": "pnpm --filter @mizu/backend run audit"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tree-sitter-grammars/tree-sitter-yaml",
      "sharp",
      "tesseract.js",
      "tree-sitter",
      "tree-sitter-json",
      "unrs-resolver"
    ],
    "overrides": {
      "@xmldom/xmldom": "^0.8.15",
      "js-yaml@4": "^4.3.2",
      "immutable@3": "^3.8.4",
      "postcss": "^8.5.23",
      "nanoid@3": "^3.3.18",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "brace-expansion@1": "^1.1.18",
      "uuid@8": "^11.1.1",
      "minimatch@10>brace-expansion": "5.0.12",
      "axios": "^1.20.0",
      "dompurify": "3.4.17",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "brace-expansion@>=4 <6": "5.0.12",
      "shell-quote": "1.12.0",
      "compression": "1.8.2",
      "follow-redirects": "1.16.1",
      "fast-uri@3": "3.1.9",
      "undici@7": "7.30.1",
      "ip-address@10": "10.7.4",
      "proxy-addr": "2.0.8",
      "@modelcontextprotocol/sdk": "1.32.1",
      "node-forge": "https://codeload.github.com/Krysthyan/forge/tar.gz/ceba34402e329f0365134f23fe19898756527d65",
      "vite": "8.2.4",
      "uuid@7": "11.1.1",
      "hono": "4.13.13",
      "@hono/node-server@1": "1.19.17",
      "qs@6": "6.16.1",
      "postcss-selector-parser@7": "7.1.7",
      "music-metadata@11": "11.16.1",
      "decode-uri-component": "0.5.1",
      "body-parser@2": "2.4.0",
      "zod": "4.6.6"
    },
    "patchedDependencies": {
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
    }
  }
}
