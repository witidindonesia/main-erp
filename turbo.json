{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "bin/**"
      ]
    },
    "lint": {
      "cache": false
    },
    "check-types": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
